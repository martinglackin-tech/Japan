{
    "name": "jf-japan-phrasebook",
    "private": true,
    "description": "Josey & Frankie's Japanese phrasebook",
    "scripts": {
        "build": "npm run build:css && npm run build:vendor",
        "build:css": "tailwindcss -i src/input.css -o styles.css --minify",
        "build:vendor": "node -e \"require('fs').mkdirSync('vendor',{recursive:true});require('fs').copyFileSync('node_modules/canvas-confetti/dist/confetti.browser.js','vendor/confetti.browser.js')\"",
        "build:audio": "node tools/generate-audio.mjs"
    },
    "devDependencies": {
        "canvas-confetti": "1.9.3",
        "tailwindcss": "3.4.17"
    }
}
